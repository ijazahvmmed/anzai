---
import Experience from '../components/Experience';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f1e2" />
    <meta name="description" content="A life outside, beautifully considered. Everfield brings landscape design, thoughtful installation, and seasonal garden care together." />
    <meta property="og:title" content="Everfield — A life outside" />
    <meta property="og:description" content="Considered gardens. Extraordinary everyday living." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/hero.webp" />
    <title>Everfield — A life outside</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/serif.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/sans.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/images/hero.webp" as="image" fetchpriority="high" />
  </head>
  <body><Experience client:load /></body>
</html>
